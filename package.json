{
  "name": "tml-db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --preload @opentui/solid/preload --watch src/tui/index.tsx",
    "start": "bun --preload @opentui/solid/preload src/tui/index.tsx",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "test:tui": "bun test ./src/tui",
    "test:mcp": "bun test ./src/mcp",
    "mcp:start": "bun src/mcp/server.ts",
    "mcp:check": "bun src/mcp/check.ts"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@bytebase/dbhub": "1.5.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@opentui/core": "^0.6.6",
    "@opentui/keymap": "^0.6.6",
    "@opentui/solid": "^0.6.6",
    "solid-js": "1.9.12",
    "sql-formatter": "^15.9.0",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "prettier": "3.9.10",
    "typescript": "^7.0.2"
  }
}
