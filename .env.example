# Copy to .env at the project root. Never commit credentials.
# Select a named connection via active in config/connections.toml.
# Only the active connection's variable is required. Use read-only accounts.
# DEV_DATABASE_URL=postgres://readonly:CHANGE_ME@127.0.0.1:5432/database?sslmode=disable
# PROD_DATABASE_URL=postgres://readonly:CHANGE_ME@db.example.com:5432/database?sslmode=verify-full

# Optional alternate catalog (relative to project root, or absolute).
# DBHUB_CONNECTIONS_FILE=config/connections.toml

# Legacy fallback ONLY when no default TOML catalog exists.
# DBHUB_DSN=postgres://readonly:CHANGE_ME@127.0.0.1:5432/database?sslmode=disable
